{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_ENV": "production",
        "EXPO_PUBLIC_API_URL": "http://3.139.105.48:8000",
        "EXPO_PUBLIC_SOCKET_URL": "http://3.139.105.48:8000",
        "SENTRY_AUTH_TOKEN": "$SENTRY_AUTH_TOKEN",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "tunnel": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://3.139.105.48:8000",
        "EXPO_PUBLIC_SOCKET_URL": "http://3.139.105.48:8000",
        "GOOGLE_MAPS_API_KEY": "$GOOGLE_MAPS_API_KEY"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6766738125"
      }
    },
    "tunnel": {
      "ios": {
        "ascAppId": "6766738125"
      }
    }
  }
}
